# Copy to .env and fill in. Every variable here must also be set in the Vercel
# project environment (Project Settings -> Environment Variables) — .env is
# gitignored and never uploaded, so the deployment reads them from Vercel.

# --- Model -------------------------------------------------------------------
# agent/agent.ts calls OpenRouter directly rather than going through the Vercel
# AI Gateway, so this key is required even on Vercel.
OPENROUTER_API_KEY=sk-or-v1-...

# --- Database ----------------------------------------------------------------
# Supabase Postgres connection string, used by database/db.ts.
#
# Use the Supavisor POOLER host, not the direct `db.<ref>.supabase.co` one:
# the direct host is IPv6-only and unreachable from IPv4-only networks.
# Supabase dashboard -> Project Settings -> Database -> Connection string.
# Note the username is `postgres.<project-ref>`, not plain `postgres`.
#
#   Session mode     (port 5432): behaves like a normal Postgres connection
#   Transaction mode (port 6543): better for serverless fan-out, no prepared statements
SUPABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- Route auth --------------------------------------------------------------
# Credentials for the agent's HTTP API (/eve/v1/*), checked by
# agent/channels/eve.ts. Without ROUTE_AUTH_BASIC_PASSWORD set, the basic-auth
# entry is not registered at all and every session route stays closed — that is
# deliberate, so an unconfigured deployment cannot accept an empty password.
#
# Generate one with:  node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ROUTE_AUTH_BASIC_USERNAME=scoutly
ROUTE_AUTH_BASIC_PASSWORD=
