# Build artifacts and local state
node_modules
.env*
.eve
.next
.output
.nitro
dist

# Not used by the deployed agent. The scraper runs locally and writes
# raw.jsonl, which is pipeline input, not something the agent reads at runtime.
scraper
docs

# The pipeline is a separate deployment target (trigger.dev), not part of the
# agent's Vercel build.
trigger
scripts
trigger.config.ts

# The Next.js console is its own Vercel project, with its Root Directory
# set to web/. The agent deployment must not upload it.
web

# Local tooling
.claude
.agents
.DS_Store
*.tsbuildinfo
