# The console only reads from the database, through its own Route Handlers.
# The browser never receives this value: it has no NEXT_PUBLIC_ prefix and is
# only read in server-only code (src/lib/server/db.ts).
#
# Use the Supabase Supavisor POOLER connection string — the direct
# db.<ref>.supabase.co host is IPv6-only. Transaction mode (port 6543) suits
# Vercel's serverless functions best.
SUPABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
